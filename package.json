{
  "name": "attendify-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-webview.js && node scripts/patch-expo-dev-menu.cjs && node scripts/build-acoustic-runtime.cjs",
    "test": "node scripts/build-acoustic-runtime.cjs --check && node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "acoustic:generate": "node scripts/build-acoustic-runtime.cjs",
    "prestart": "npm run acoustic:generate",
    "preandroid": "npm run acoustic:generate",
    "preios": "npm run acoustic:generate",
    "preweb": "npm run acoustic:generate",
    "test:audio-browser": "node scripts/build-acoustic-runtime.cjs --check && node scripts/test-audio-browser.cjs"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bluetooth-ble": "^0.4.4",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "^13.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
