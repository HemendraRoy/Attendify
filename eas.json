{
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -Pexpo.devmenu.configureInRelease=true"
      },
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ATTENDIFY_DEV_ATTENDANCE_X": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
